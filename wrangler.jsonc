{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grokbot-discord",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "observability": { "enabled": true },
  "vars": {
    // Non-secret settings. Override here or in the dashboard.
    "ALLOWED_GUILD_IDS": "",
    "ALLOWED_CHANNEL_IDS": "",
    "GROKBOT_WEBHOOK_AUTH_HEADER": "Authorization",
    "GROKBOT_WEBHOOK_AUTH_SCHEME": "Bearer"
  }
  // Secrets, set with `npx wrangler secret put <NAME>`:
  //   DISCORD_PUBLIC_KEY, ALLOWED_USER_IDS, GROKBOT_WEBHOOK_URL, GROKBOT_WEBHOOK_KEY
}
